{
  "realm": "gwag",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [
    {
      "name": "gwag-admins"
    },
    {
      "name": "gwag-devs"
    }
  ],
  "clients": [
    {
      "clientId": "gwag",
      "name": "gwag admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "sso-example-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:28500/auth/callback"
      ],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.claim": "true",
            "introspection.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "roles_groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles_groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.claim": "true",
            "introspection.token.claim": "true",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],

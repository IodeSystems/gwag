{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ListOutBody": {
        "additionalProperties": false,
        "properties": {
          "orders": {
            "items": {
              "$ref": "#/components/schemas/Order"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "orders"
        ],
        "type": "object"
      },
      "Order": {
        "additionalProperties": false,
        "properties": {
          "amountCents": {
            "description": "Money in integer minor units (cents) of the order's currency.",
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer",
            "x-gwag-scalar": "Cents"
          },
          "currency": {
            "description": "ISO 4217 code.",
            "type": "string"
          },
          "customer": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "refundedCents": {
            "description": "Money in integer minor units (cents) of the order's currency.",
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer",
            "x-gwag-scalar": "Cents"
          },
          "status": {
            "enum": [
              "open",
              "closed",
              "refunded"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "amountCents",
          "currency",
          "customer",
          "status",
          "refundedCents"
        ],
        "type": "object"
      },
      "RefundInBody": {
        "additionalProperties": false,
        "properties": {
          "amountCents": {
            "description": "Money in integer minor units (cents) of the order's currency.",
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer",
            "x-gwag-scalar": "Cents"
          }
        },
        "required": [
          "amountCents"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "orders",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v2/orders": {
      "get": {
        "operationId": "listOrders",
        "parameters": [
          {
            "description": "Money in integer minor units (cents) of the order's currency.",
            "explode": false,
            "in": "query",
            "name": "minAmountCents",
            "schema": {
              "description": "Money in integer minor units (cents) of the order's currency.",
              "format": "int64",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
              "x-gwag-scalar": "Cents"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "currency",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListOutBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        }
      }
    },
    "/v2/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        }
      }
    },
    "/v2/orders/{id}/refund": {
      "post": {
        "operationId": "refundOrder",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefundInBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        }
      }
    }
  }
}

{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "gwag cluster, 3 node(s) on ECS Fargate. Generated by gwag deploy export.",
  "Outputs": {
    "AdminSecretArn": {
      "Description": "aws secretsmanager get-secret-value --secret-id \u003cthis\u003e --query SecretString --output text",
      "Value": {
        "Ref": "AdminSecret"
      }
    },
    "ClusterName": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "LoadBalancerDns": {
      "Description": "HTTP endpoint: http://\u003cthis\u003e/api/graphql",
      "Value": {
        "Fn::GetAtt": [
          "LoadBalancer",
          "DNSName"
        ]
      }
    }
  },
  "Parameters": {
    "AlbCidr": {
      "Default": "0.0.0.0/0",
      "Description": "Who may reach the load balancer on port 80.",
      "Type": "String"
    },
    "AssignPublicIp": {
      "AllowedValues": [
        "ENABLED",
        "DISABLED"
      ],
      "Default": "ENABLED",
      "Description": "ENABLED when the subnets are public. DISABLED needs a NAT gateway or VPC endpoints to pull the image.",
      "Type": "String"
    },
    "Image1": {
      "Default": "example.com/gwag:v1",
      "Description": "Image of node 1. Fargate pulls from a registry: set a registry reference. Change one node per stack update.",
      "Type": "String"
    },
    "Image2": {
      "Default": "example.com/gwag:v1",
      "Description": "Image of node 2. Fargate pulls from a registry: set a registry reference. Change one node per stack update.",
      "Type": "String"
    },
    "Image3": {
      "Default": "example.com/gwag:v1",
      "Description": "Image of node 3. Fargate pulls from a registry: set a registry reference. Change one node per stack update.",
      "Type": "String"
    },
    "InternalCidr": {
      "Default": "10.0.0.0/8",
      "Description": "Who may reach the control plane (port 50090): your services' network.",
      "Type": "String"
    },
    "NamespaceName": {
      "Default": "gwag.local",
      "Description": "Cloud Map private DNS namespace. Peers dial gwag-N.\u003cthis\u003e.",
      "Type": "String"
    },
    "SubnetA": {
      "Description": "Subnet for ALB, EFS mount target and tasks. Different AZ from SubnetB.",
      "Type": "AWS::EC2::Subnet::Id"
    },
    "SubnetB": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    }
  },
  "Resources": {
    "AccessPoint1": {
      "Properties": {
        "FileSystemId": {
          "Ref": "FileSystem"
        },
        "PosixUser": {
          "Gid": "65532",
          "Uid": "65532"
        },
        "RootDirectory": {
          "CreationInfo": {
            "OwnerGid": "65532",
            "OwnerUid": "65532",
            "Permissions": "750"
          },
          "Path": "/gwag-1"
        }
      },
      "Type": "AWS::EFS::AccessPoint"
    },
    "AccessPoint2": {
      "Properties": {
        "FileSystemId": {
          "Ref": "FileSystem"
        },
        "PosixUser": {
          "Gid": "65532",
          "Uid": "65532"
        },
        "RootDirectory": {
          "CreationInfo": {
            "OwnerGid": "65532",
            "OwnerUid": "65532",
            "Permissions": "750"
          },
          "Path": "/gwag-2"
        }
      },
      "Type": "AWS::EFS::AccessPoint"
    },
    "AccessPoint3": {
      "Properties": {
        "FileSystemId": {
          "Ref": "FileSystem"
        },
        "PosixUser": {
          "Gid": "65532",
          "Uid": "65532"
        },
        "RootDirectory": {
          "CreationInfo": {
            "OwnerGid": "65532",
            "OwnerUid": "65532",
            "Permissions": "750"
          },
          "Path": "/gwag-3"
        }
      },
      "Type": "AWS::EFS::AccessPoint"
    },
    "AdminSecret": {
      "Properties": {
        "Description": "gwag admin bearer token (hex)",
        "GenerateSecretString": {
          "ExcludeCharacters": "ghijklmnopqrstuvwxyz",
          "ExcludePunctuation": true,
          "ExcludeUppercase": true,
          "PasswordLength": 64
        }
      },
      "Type": "AWS::SecretsManager::Secret"
    },
    "AlbSecurityGroup": {
      "Properties": {
        "GroupDescription": "gwag load balancer",
        "SecurityGroupIngress": [
          {
            "CidrIp": {
              "Ref": "AlbCidr"
            },
            "FromPort": 80,
            "IpProtocol": "tcp",
            "ToPort": 80
          }
        ],
        "VpcId": {
          "Ref": "VpcId"
        }
      },
      "Type": "AWS::EC2::SecurityGroup"
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster"
    },
    "Discovery1": {
      "Properties": {
        "DnsConfig": {
          "DnsRecords": [
            {
              "TTL": 10,
              "Type": "A"
            }
          ],
          "RoutingPolicy": "MULTIVALUE"
        },
        "Name": "gwag-1",
        "NamespaceId": {
          "Fn::GetAtt": [
            "Namespace",
            "Id"
          ]
        }
      },
      "Type": "AWS::ServiceDiscovery::Service"
    },
    "Discovery2": {
      "Properties": {
        "DnsConfig": {
          "DnsRecords": [
            {
              "TTL": 10,
              "Type": "A"
            }
          ],
          "RoutingPolicy": "MULTIVALUE"
        },
        "Name": "gwag-2",
        "NamespaceId": {
          "Fn::GetAtt": [
            "Namespace",
            "Id"
          ]
        }
      },
      "Type": "AWS::ServiceDiscovery::Service"
    },
    "Discovery3": {
      "Properties": {
        "DnsConfig": {
          "DnsRecords": [
            {
              "TTL": 10,
              "Type": "A"
            }
          ],
          "RoutingPolicy": "MULTIVALUE"
        },
        "Name": "gwag-3",
        "NamespaceId": {
          "Fn::GetAtt": [
            "Namespace",
            "Id"
          ]
        }
      },
      "Type": "AWS::ServiceDiscovery::Service"
    },
    "EfsSecurityGroup": {
      "Properties": {
        "GroupDescription": "gwag EFS",
        "SecurityGroupIngress": [
          {
            "FromPort": 2049,
            "IpProtocol": "tcp",
            "SourceSecurityGroupId": {
              "Ref": "TaskSecurityGroup"
            },
            "ToPort": 2049
          }
        ],
        "VpcId": {
          "Ref": "VpcId"
        }
      },
      "Type": "AWS::EC2::SecurityGroup"
    },
    "ExecutionRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        ],
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "secretsmanager:GetSecretValue",
                  "Effect": "Allow",
                  "Resource": {
                    "Ref": "AdminSecret"
                  }
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "read-admin-secret"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "FileSystem": {
      "Properties": {
        "Encrypted": true,
        "PerformanceMode": "generalPurpose",
        "ThroughputMode": "elastic"
      },
      "Type": "AWS::EFS::FileSystem"
    },
    "Listener": {
      "Properties": {
        "DefaultActions": [
          {
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            },
            "Type": "forward"
          }
        ],
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 80,
        "Protocol": "HTTP"
      },
      "Type": "AWS::ElasticLoadBalancingV2::Listener"
    },
    "LoadBalancer": {
      "Properties": {
        "Scheme": "internet-facing",
        "SecurityGroups": [
          {
            "Ref": "AlbSecurityGroup"
          }
        ],
        "Subnets": [
          {
            "Ref": "SubnetA"
          },
          {
            "Ref": "SubnetB"
          }
        ],
        "Type": "application"
      },
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer"
    },
    "LogGroup": {
      "Properties": {
        "RetentionInDays": 30
      },
      "Type": "AWS::Logs::LogGroup"
    },
    "MountTargetA": {
      "Properties": {
        "FileSystemId": {
          "Ref": "FileSystem"
        },
        "SecurityGroups": [
          {
            "Ref": "EfsSecurityGroup"
          }
        ],
        "SubnetId": {
          "Ref": "SubnetA"
        }
      },
      "Type": "AWS::EFS::MountTarget"
    },
    "MountTargetB": {
      "Properties": {
        "FileSystemId": {
          "Ref": "FileSystem"
        },
        "SecurityGroups": [
          {
            "Ref": "EfsSecurityGroup"
          }
        ],
        "SubnetId": {
          "Ref": "SubnetB"
        }
      },
      "Type": "AWS::EFS::MountTarget"
    },
    "Namespace": {
      "Properties": {
        "Name": {
          "Ref": "NamespaceName"
        },
        "Vpc": {
          "Ref": "VpcId"
        }
      },
      "Type": "AWS::ServiceDiscovery::PrivateDnsNamespace"
    },
    "Service1": {
      "DependsOn": [
        "Listener",
        "MountTargetA",
        "MountTargetB"
      ],
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MaximumPercent": 100,
          "MinimumHealthyPercent": 0
        },
        "DesiredCount": 1,
        "HealthCheckGracePeriodSeconds": 180,
        "LaunchType": "FARGATE",
        "LoadBalancers": [
          {
            "ContainerName": "gwag",
            "ContainerPort": 8080,
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": {
              "Ref": "AssignPublicIp"
            },
            "SecurityGroups": [
              {
                "Ref": "TaskSecurityGroup"
              }
            ],
            "Subnets": [
              {
                "Ref": "SubnetA"
              },
              {
                "Ref": "SubnetB"
              }
            ]
          }
        },
        "PlatformVersion": "LATEST",
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "Discovery1",
                "Arn"
              ]
            }
          }
        ],
        "TaskDefinition": {
          "Ref": "TaskDef1"
        }
      },
      "Type": "AWS::ECS::Service"
    },
    "Service2": {
      "DependsOn": [
        "Listener",
        "MountTargetA",
        "MountTargetB"
      ],
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MaximumPercent": 100,
          "MinimumHealthyPercent": 0
        },
        "DesiredCount": 1,
        "HealthCheckGracePeriodSeconds": 180,
        "LaunchType": "FARGATE",
        "LoadBalancers": [
          {
            "ContainerName": "gwag",
            "ContainerPort": 8080,
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": {
              "Ref": "AssignPublicIp"
            },
            "SecurityGroups": [
              {
                "Ref": "TaskSecurityGroup"
              }
            ],
            "Subnets": [
              {
                "Ref": "SubnetA"
              },
              {
                "Ref": "SubnetB"
              }
            ]
          }
        },
        "PlatformVersion": "LATEST",
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "Discovery2",
                "Arn"
              ]
            }
          }
        ],
        "TaskDefinition": {
          "Ref": "TaskDef2"
        }
      },
      "Type": "AWS::ECS::Service"
    },
    "Service3": {
      "DependsOn": [
        "Listener",
        "MountTargetA",
        "MountTargetB"
      ],
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MaximumPercent": 100,
          "MinimumHealthyPercent": 0
        },
        "DesiredCount": 1,
        "HealthCheckGracePeriodSeconds": 180,
        "LaunchType": "FARGATE",
        "LoadBalancers": [
          {
            "ContainerName": "gwag",
            "ContainerPort": 8080,
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": {
              "Ref": "AssignPublicIp"
            },
            "SecurityGroups": [
              {
                "Ref": "TaskSecurityGroup"
              }
            ],
            "Subnets": [
              {
                "Ref": "SubnetA"
              },
              {
                "Ref": "SubnetB"
              }
            ]
          }
        },
        "PlatformVersion": "LATEST",
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "Discovery3",
                "Arn"
              ]
            }
          }
        ],
        "TaskDefinition": {
          "Ref": "TaskDef3"
        }
      },
      "Type": "AWS::ECS::Service"
    },
    "TargetGroup": {
      "Properties": {
        "HealthCheckIntervalSeconds": 10,
        "HealthCheckPath": "/api/health",
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "Matcher": {
          "HttpCode": "200"
        },
        "Port": 8080,
        "Protocol": "HTTP",
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ],
        "TargetType": "ip",
        "UnhealthyThresholdCount": 2,
        "VpcId": {
          "Ref": "VpcId"
        }
      },
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup"
    },
    "TaskDef1": {
      "Properties": {
        "ContainerDefinitions": [
          {
            "Command": [
              "up",
              "--data-dir=/data",
              "--no-context-write",
              "--addr=:8080",
              "--control-plane=:50090",
              "--nats-listen=:14222",
              "--nats-cluster=:14248",
              "--node-name=gwag-1",
              "--shutdown-delay=10s",
              "--shutdown-timeout=30s",
              {
                "Fn::Sub": "--nats-peer=gwag-2.${NamespaceName}:14248"
              },
              {
                "Fn::Sub": "--nats-peer=gwag-3.${NamespaceName}:14248"
              }
            ],
            "Essential": true,
            "HealthCheck": {
              "Command": [
                "CMD",
                "/gwag",
                "probe",
                "--live",
                "http://localhost:8080/api/health"
              ],
              "Interval": 10,
              "Retries": 6,
              "StartPeriod": 120,
              "Timeout": 5
            },
            "Image": {
              "Ref": "Image1"
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "gwag"
              }
            },
            "MountPoints": [
              {
                "ContainerPath": "/data",
                "SourceVolume": "data"
              }
            ],
            "Name": "gwag",
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              },
              {
                "ContainerPort": 50090,
                "Protocol": "tcp"
              },
              {
                "ContainerPort": 14222,
                "Protocol": "tcp"
              },
              {
                "ContainerPort": 14248,
                "Protocol": "tcp"
              }
            ],
            "ReadonlyRootFilesystem": true,
            "Secrets": [
              {
                "Name": "GWAG_ADMIN_TOKEN",
                "ValueFrom": {
                  "Ref": "AdminSecret"
                }
              }
            ],
            "StopTimeout": 90
          }
        ],
        "Cpu": "512",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "Family": "gwag-1",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "Volumes": [
          {
            "EFSVolumeConfiguration": {
              "AuthorizationConfig": {
                "AccessPointId": {
                  "Ref": "AccessPoint1"
                },
                "IAM": "DISABLED"
              },
              "FilesystemId": {
                "Ref": "FileSystem"
              },
              "TransitEncryption": "ENABLED"
            },
            "Name": "data"
          }
        ]
      },
      "Type": "AWS::ECS::TaskDefinition"
    },
    "TaskDef2": {
      "Properties": {
        "ContainerDefinitions": [
          {
            "Command": [
              "up",
              "--data-dir=/data",
              "--no-context-write",
              "--addr=:8080",
              "--control-plane=:50090",
              "--nats-listen=:14222",
              "--nats-cluster=:14248",
              "--node-name=gwag-2",
              "--shutdown-delay=10s",
              "--shutdown-timeout=30s",
              {
                "Fn::Sub": "--nats-peer=gwag-1.${NamespaceName}:14248"
              },
              {

                "--live",
                "http://localhost:8080/api/health"
              ],
              "Interval": 10,
              "Retries": 6,
              "StartPeriod": 120,
              "Timeout": 5
            },
            "Image": {
              "Ref": "Image2"
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "gwag"
              }
            },
            "MountPoints": [
              {
                "ContainerPath": "/data",
                "SourceVolume": "data"
              }
            ],
            "Name": "gwag",
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              },
              {
                "ContainerPort": 50090,
                "Protocol": "tcp"
              },
              {
                "ContainerPort": 14222,
                "Protocol": "tcp"
              },
              {
                "ContainerPort": 14248,
                "Protocol": "tcp"
              }
            ],
            "ReadonlyRootFilesystem": true,
            "Secrets": [
              {
                "Name": "GWAG_ADMIN_TOKEN",
                "ValueFrom": {
                  "Ref": "AdminSecret"
                }
              }
            ],
            "StopTimeout": 90
          }
        ],
        "Cpu": "512",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "Family": "gwag-2",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "Volumes": [
          {
            "EFSVolumeConfiguration": {
              "AuthorizationConfig": {
                "AccessPointId": {
                  "Ref": "AccessPoint2"
                },
                "IAM": "DISABLED"
              },
              "FilesystemId": {
                "Ref": "FileSystem"
              },
              "TransitEncryption": "ENABLED"
            },
            "Name": "data"
          }
        ]
      },
      "Type": "AWS::ECS::TaskDefinition"
    },
    "TaskDef3": {
      "Properties": {
        "ContainerDefinitions": [
          {
            "Command": [
              "up",
              "--data-dir=/data",
              "--no-context-write",
              "--addr=:8080",
              "--control-plane=:50090",
              "--nats-listen=:14222",
              "--nats-cluster=:14248",
              "--node-name=gwag-3",
              "--shutdown-delay=10s",
              "--shutdown-timeout=30s",
              {
                "Fn::Sub": "--nats-peer=gwag-1.${NamespaceName}:14248"
              },
              {
                "Fn::Sub": "--nats-peer=gwag-2.${NamespaceName}:14248"
              }
            ],
            "Essential": true,
            "HealthCheck": {
              "Command": [

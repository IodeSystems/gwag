              },
              {
                "ContainerPort": 14222,
                "Protocol": "tcp"
              },
              {
                "ContainerPort": 14248,
                "Protocol": "tcp"
              }
            ],
            "ReadonlyRootFilesystem": true,
            "Secrets": [
              {
                "Name": "GWAG_ADMIN_TOKEN",
                "ValueFrom": {
                  "Ref": "AdminSecret"
                }
              }
            ],
            "StopTimeout": 90
          }
        ],
        "Cpu": "512",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "Family": "gwag-3",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "Volumes": [
          {
            "EFSVolumeConfiguration": {
              "AuthorizationConfig": {
                "AccessPointId": {
                  "Ref": "AccessPoint3"
                },
                "IAM": "DISABLED"
              },
              "FilesystemId": {
                "Ref": "FileSystem"
              },
              "TransitEncryption": "ENABLED"
            },
            "Name": "data"
          }
        ]
      },
      "Type": "AWS::ECS::TaskDefinition"
    },
    "TaskFromAlb": {
      "Properties": {
        "FromPort": 8080,
        "GroupId": {
          "Ref": "TaskSecurityGroup"
        },
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Ref": "AlbSecurityGroup"
        },
        "ToPort": 8080
      },
      "Type": "AWS::EC2::SecurityGroupIngress"
    },
    "TaskFromTask": {
      "Properties": {
        "Description": "NATS routes between nodes",
        "FromPort": 14248,
        "GroupId": {
          "Ref": "TaskSecurityGroup"
        },
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Ref": "TaskSecurityGroup"
        },
        "ToPort": 14248
      },
      "Type": "AWS::EC2::SecurityGroupIngress"
    },

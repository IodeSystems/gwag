{
  "name": "@gwag/registration",
  "version": "0.0.0",
  "private": true,
  "description": "Light registration client for gwag's control plane: announce, wait for ok, heartbeat, deregister",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./proto/*_pb.js": "./src/gen/*_pb.ts"
  },
  "scripts": {
    "gen": "./gen.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-node": "2.3.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}

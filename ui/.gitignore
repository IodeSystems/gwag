node_modules/
.vite/

# dist/ is build output. Only the empty dist/.gitkeep is tracked, so
# //go:embed all:dist compiles without a UI build (go install from the
# module proxy). embed.go serves ui/fallback/ when dist/ has no
# index.html; vite.config.ts restores .gitkeep after a build.
dist/*
!dist/.gitkeep
*.log
.DS_Store

# Generated by codegen / router plugin. Re-run `pnpm run gen` after
# the schema changes; CI re-runs both before tsc.
# Kept under version control as placeholders so type-checking works
# on a fresh clone; the build pipeline overwrites them.
# (uncomment if you'd rather not track generated artifacts):
# src/api/gateway.ts
# src/routeTree.gen.ts
# schema.graphql
.swc/
